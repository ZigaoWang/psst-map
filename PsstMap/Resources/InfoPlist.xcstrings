    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Why the app asks for location",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psst uses your location to show the places around you and sort the feed by distance. It never leaves your device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psst 使用你的位置来显示你周围的地点，并按距离排列推荐内容。你的位置不会离开此设备。"
          }
        }
      }
